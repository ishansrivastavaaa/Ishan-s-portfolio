rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { return request.resource.data; }
    
    function isValidContactMessage(data) {
      return data.keys().hasAll(['name', 'email', 'message', 'createdAt']) && 
             data.keys().size() == 4 &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             data.message is string && data.message.size() <= 2000 &&
             data.createdAt == request.time;
    }

    match /contacts/{contactId} {
      // Anyone can submit a contact form (create), but no one can read or update from the client
      allow create: if isValidId(contactId) && isValidContactMessage(incoming());
      allow read: if true;
      allow update, delete: if false;
    }
  }
}
